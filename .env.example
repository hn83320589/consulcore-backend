# ConsulCore Backend — 環境變數範例
# 複製此檔案為 .env 或設定為系統環境變數

# 資料庫連線
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=consulcore;User=root;Password=YOUR_PASSWORD;

# JWT 設定
Jwt__SecretKey=YOUR-JWT-SECRET-KEY-AT-LEAST-32-CHARS-LONG!!
Jwt__Issuer=ConsulCore
Jwt__ExpiryHours=24

# AES-256-GCM 加密金鑰（Base64 編碼的 32 bytes）
# 產生方式：python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
Encryption__Key=YOUR_BASE64_ENCODED_32_BYTE_KEY

# CORS 允許的來源
AllowedOrigins__0=http://localhost:5173
